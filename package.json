{
  "name": "@0to10/profiles",
  "description": "Typescript library for working with encrypted profiles",
  "version": "1.3.3",
  "author": "0TO10 <open-source-software@0to10.nl>",
  "homepage": "https://0to10.nl",
  "keywords": [
    "cryptography",
    "encryption",
    "profile",
    "secure",
    "security",
    "user"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "files": [
    "dist/"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "node_modules/.bin/tsc -p tsconfig.json && node_modules/.bin/tsc -p tsconfig-cjs.json",
    "build:clean": "(rm -r dist || true) && npm run build",
    "lint": "node_modules/.bin/eslint . --ext .ts",
    "lint:fix": "eslint --fix . --ext .ts",
    "test": "jest",
    "prepublishOnly": "npm run build:clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0to10/secure-profile-library-ts.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/0to10/secure-profile-library-ts/issues"
  },
  "dependencies": {
    "@peculiar/webcrypto": "^1.4.3",
    "pkijs": "^3.0.15",
    "scrypt-js": "^3.0.1",
    "unorm": "^1.6.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.5.0",
    "@types/unorm": "^1.3.29",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "buffer": "~6.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-deprecation": "^2.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.1",
    "tslib": "^2.2.0",
    "webpack": "5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
